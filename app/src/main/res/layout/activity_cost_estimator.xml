<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnEstimatorBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mumbai Cost Estimator"
                    android:textColor="@color/gold_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turnkey Interior Rates by Age Décor"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Area Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enter Carpet Area (sq. ft)"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCalcCarpetArea"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_luxury"
            android:hint="e.g. 1500"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:text="1500"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <!-- Quality / Tier Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select Finish &amp; Material Tier"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbTierEssential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Essential Luxury (₹1,350/sq.ft)\nModular finishes, acrylic laminates, branded hardware"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbTierPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Signature Luxury (₹1,750/sq.ft)\nItalian marble accents, PU finishes, fluted panels, Blum fittings"
                android:textColor="@color/gold_light"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbTierElite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Haute Architecture (₹2,250/sq.ft)\nFull imported marble, smart home automation, bespoke artisanal brass"
                android:textColor="@color/copper_accent"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/bg_card_elevated"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/gold_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTIMATED TURNKEY INVESTMENT"
                    android:textColor="@color/gold_light"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCalculatedTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₹26,25,000"
                    android:textColor="@color/gold_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimelineEstimate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Estimated Execution Time: ~60 Working Days"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Includes 3D designs, turnkey execution, material procurement &amp; 10-year warranty."
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CTA Button to fill inquiry form with this calculated result -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookWithEstimate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/gold_primary"
            android:text="Book Consultation for This Budget"
            android:textColor="@color/bg_main"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
